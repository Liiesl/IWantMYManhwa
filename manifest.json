{
  "manifest_version": 3,
  "name": "IWantMYManhwa",
  "version": "1.4.2",
  "description": "Downloads manhwa chapters in bulk from multiple sites as ZIP files via the side panel.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.arenascan.com/*",
    "*://*.asurascans.com/*",
    "*://*.manhwaread.com/*",
    "*://*.webtoonscan.com/*",
    "*://*.wfwf499.com/*",
    "*://*.y17stm.com/*",
    "*://cdn.arenascan.com/*",
    "*://cdn4.webtoonscan.com/*",
    "*://y17stm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "wfwf_cdn_referer",
        "enabled": true,
        "path": "rules/wfwf_cdn_referer.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.arenascan.com/manga/*",
        "*://*.asurascans.com/comics/*",
        "*://*.manhwaread.com/*",
        "*://*.webtoonscan.com/manhwa/*",
        "*://*.wfwf499.com/list*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "48": "icons/icon48.png"
  },
  "action": {
    "default_title": "Open Side Panel"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "jszip.min.js",
        "pdf-lib.min.js",
        "imageTabWorker.js",
        "docs/*",
        "sites/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
